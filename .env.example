# Base URL of the deployed Hello API. Injected automatically by SST (linked
# from the Api construct). For local `npm run dev` you can leave this unset —
# the frontend falls back to the local API shim at http://localhost:3001.
# PUBLIC_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com

# Static hosting (e.g. GitHub Pages) — only needed for the inherited directory
# pages when not deploying via SST.
# SITE_URL=https://yourusername.github.io
# SITE_BASE=/your-repo-name
