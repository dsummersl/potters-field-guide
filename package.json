{
  "name": "astro-api-first-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,storybook,api -c blue,magenta,green \"astro dev\" \"storybook dev -p 6006 --no-open\" \"npm run api:local\"",
    "dev:sst": "sst dev",
    "start": "npm run dev",
    "build": "npm run api:types && astro build && npm run build:storybook",
    "build:storybook": "storybook build -o dist/storybook",
    "preview": "astro preview",
    "astro": "astro",
    "storybook": "storybook dev -p 6006",
    "api:local": "tsx watch scripts/api-local.ts",
    "api:types": "openapi-typescript src/api/openapi.yaml -o src/api/schema.gen.ts",
    "sst": "sst",
    "fetch": "npx tsx scripts/fetch-data.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/preact": "^5.1.5",
    "astro": "^6.4.8",
    "js-yaml": "^4.1.1",
    "preact": "^10.24.0",
    "tailwindcss": "^3.4.14"
  },
  "devDependencies": {
    "@storybook/preact": "^10.4.6",
    "@storybook/preact-vite": "^10.4.6",
    "@types/aws-lambda": "^8.10.145",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.4.47",
    "redoc": "^2.5.3",
    "sst": "^3.3.0",
    "storybook": "^10.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5",
    "@storybook/addon-docs": "^10.4.6"
  }
}
