---
import Layout from '@/layouts/Layout.astro';
import { getItems } from '@/lib/loader';

const items = getItems();
const initialQuery = Astro.url.searchParams.get('q') ?? '';
const base = import.meta.env.BASE_URL;

const clientItems = items.map(({ id, title, description, image, tags }) => ({
  id, title, description, image, tags: tags.join(','),
}));
---

<Layout title="Search" description="Search the directory.">

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Heading + search input -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Search</h1>
      <div class="relative max-w-xl">
        <input
          id="search-input"
          type="search"
          value={initialQuery}
          placeholder="Type to search by title, description, tags…"
          autofocus
          class="w-full pl-11 pr-4 py-3 rounded-xl border border-gray-300 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent text-gray-900 placeholder-gray-400"
        />
        <svg class="absolute left-3.5 top-3.5 h-5 w-5 text-gray-400 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
      </div>
    </div>

    <!-- Result count -->
    <p id="result-count" class="text-sm text-gray-500 mb-4">&nbsp;</p>

    <!-- Results grid -->
    <div id="results-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"></div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-20 text-gray-400">
      <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto h-16 w-16 mb-4 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <p class="text-lg font-medium">No results found</p>
      <p class="mt-1 text-sm">Try a different search term.</p>
    </div>

  </div>

  <script
    id="items-data"
    type="application/json"
    set:html={JSON.stringify({ items: clientItems, base })}
  />

  <script>
    interface ClientItem {
      id: string;
      title: string;
      description: string;
      image: string;
      tags: string;
    }

    const raw = document.getElementById('items-data')!.textContent!;
    const { items, base } = JSON.parse(raw) as { items: ClientItem[]; base: string };

    const input   = document.getElementById('search-input') as HTMLInputElement;
    const grid    = document.getElementById('results-grid')!;
    const countEl = document.getElementById('result-count')!;
    const emptyEl = document.getElementById('empty-state')!;

    function cardHTML(item: ClientItem): string {
      const tags = item.tags ? item.tags.split(',').map(t => t.trim()).filter(Boolean) : [];
      return `
        <a href="${base}items/${item.id}"
           class="group flex flex-col bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md hover:border-brand-300 transition-all duration-200">
          <div class="aspect-video bg-gray-100 overflow-hidden">
            ${item.image
              ? `<img src="${item.image}" alt="${item.title}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"/>`
              : `<div class="w-full h-full flex items-center justify-center text-gray-300">
                   <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                   </svg>
                 </div>`
            }
          </div>
          <div class="p-4 flex flex-col flex-1">
            <h3 class="font-semibold text-gray-900 group-hover:text-brand-700 transition-colors line-clamp-2 leading-snug mb-2">${item.title}</h3>
            <p class="text-sm text-gray-600 line-clamp-3">${item.description}</p>
            ${tags.length ? `<div class="mt-2 flex flex-wrap gap-1">${tags.slice(0,3).map(t => `<span class="text-xs text-gray-400 bg-gray-100 px-2 py-0.5 rounded-md">#${t}</span>`).join('')}</div>` : ''}
          </div>
        </a>`;
    }

    function render(query: string) {
      const q = query.toLowerCase();
      const filtered = q
        ? items.filter(item =>
            item.title?.toLowerCase().includes(q) ||
            item.description?.toLowerCase().includes(q) ||
            item.tags?.toLowerCase().includes(q)
          )
        : items;

      grid.innerHTML = filtered.map(cardHTML).join('');
      countEl.textContent = `${filtered.length} result${filtered.length !== 1 ? 's' : ''}`;
      emptyEl.classList.toggle('hidden', filtered.length > 0);
      grid.classList.toggle('hidden', filtered.length === 0);

      const url = new URL(window.location.href);
      if (q) url.searchParams.set('q', query); else url.searchParams.delete('q');
      history.replaceState(null, '', url.toString());
    }

    input.addEventListener('input', e => render((e.target as HTMLInputElement).value));
    render(input.value);
  </script>

</Layout>
