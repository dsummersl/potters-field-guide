---
// Thin wrapper around the Storybook-documented component so pages can use the
// familiar `<ItemCard item={item} />` while the single source of truth lives in
// src/components/ui/ItemCard.tsx (rendered to static HTML here — no hydration).
import { ItemCard } from '@/components/ui/ItemCard';
import type { SiteItem } from '@/lib/types';

interface Props {
  item: SiteItem;
}

const { item } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ItemCard item={item} base={base} />
