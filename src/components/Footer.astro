---
// Wrapper that resolves base-prefixed links and renders the Storybook-documented
// SiteFooter (static — no hydration). Source of truth: ui/SiteFooter.tsx.
import { SiteFooter } from '@/components/ui/SiteFooter';

const base = import.meta.env.BASE_URL;
const links = [
  { href: base,            label: 'Home'   },
  { href: `${base}items`,  label: 'Browse' },
  { href: `${base}search`, label: 'Search' },
];
---

<SiteFooter brand="SheetSite" homeHref={base} links={links} />
