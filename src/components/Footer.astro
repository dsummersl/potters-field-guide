---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-200 mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">

      <div class="text-center md:text-left">
        <p class="font-semibold text-gray-800">SheetSite</p>
        <p class="text-sm text-gray-500 mt-1">
          A directory template powered by&nbsp;
          <a href="https://astro.build" class="underline hover:text-brand-600" target="_blank" rel="noopener">Astro</a>
          &nbsp;+&nbsp;
          <a href="https://sheets.google.com" class="underline hover:text-brand-600" target="_blank" rel="noopener">Google Sheets</a>.
        </p>
      </div>

      <nav class="flex gap-6 text-sm text-gray-500">
        <a href={base} class="hover:text-gray-900 transition-colors">Home</a>
        <a href={`${base}items`} class="hover:text-gray-900 transition-colors">Browse</a>
        <a href={`${base}search`} class="hover:text-gray-900 transition-colors">Search</a>
      </nav>
    </div>

    <p class="mt-8 text-center text-xs text-gray-400">&copy; {year} SheetSite. MIT License.</p>
  </div>
</footer>
