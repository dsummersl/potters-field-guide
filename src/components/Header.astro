---
// Wrapper that resolves base-prefixed nav links + the current path and renders
// the Storybook-documented SiteHeader. Hydrated (client:load) so the mobile
// menu toggle works; the single source of truth is ui/SiteHeader.tsx.
import { SiteHeader } from '@/components/ui/SiteHeader';

const base = import.meta.env.BASE_URL;
// In dev Storybook runs on its own port; the built site serves it at /storybook.
const storybookHref = import.meta.env.DEV ? 'http://localhost:6006/' : `${base}storybook/`;
const links = [
  { href: base,              label: 'Home'      },
  { href: `${base}items`,    label: 'Browse'    },
  { href: `${base}demo`,     label: 'API Demo'  },
  { href: `${base}api-docs`, label: 'API Docs'  },
  { href: storybookHref,     label: 'Storybook' },
];
const current = Astro.url.pathname;
---

<SiteHeader
  client:load
  brand="SheetSite"
  homeHref={base}
  currentPath={current}
  links={links}
/>
